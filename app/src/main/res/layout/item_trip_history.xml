<?xml version="1.0" encoding="utf-8"?>
<!-- One trip card on the Trip History page (filled in by TripHistoryActivity.kt) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_receipt_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Top row: line pill + date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tripLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_purple_solid"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="LRT-2"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tripDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/plusjakartasans"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:text="--"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:drawableTint="#94A3B8" />
    </LinearLayout>

    <!-- Route: origin → destination -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="0.05"
                android:text="ORIGIN"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tripOrigin"
                android:textAllCaps="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="--"
                android:textColor="@color/neutral_heading"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tripArrow"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/brand" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="0.05"
                android:text="DESTINATION"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tripDestination"
                android:textAllCaps="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="end"
                android:text="--"
                android:textColor="@color/neutral_heading"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dashed divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dashed_line"
        android:layerType="software" />

    <!-- Fare row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/plusjakartasans"
            android:text="Fare"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tripFare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="₱0.00"
            android:textColor="@color/neutral_heading"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
