<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#1E293B" />
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TURNSTILE PASS SCANNER"
            android:fontFamily="@font/plusjakartasans"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1D263A"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Route and reference card -->
            <LinearLayout
                android:id="@+id/miniRouteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_rt_qr_route">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/lineBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rt_qr_badge"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="LRT-2"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/refNumber"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Ref # --"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#8189A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/lblOrigin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ORIGIN"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#9CA9BD" />
                        <TextView
                            android:id="@+id/tvOrigin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="2"
                            android:text="--"
                            android:textColor="#1D2738"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/routeArrow"
                        android:layout_width="26dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="to destination"
                        app:tint="#6B56C8" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/lblDestination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="DESTINATION"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#9CA9BD" />
                        <TextView
                            android:id="@+id/tvDestination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:layout_marginTop="2dp"
                            android:maxLines="2"
                            android:text="--"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="#1D2738" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvScannerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="Scan each QR pass at turnstile gate reader one by one."
                android:textColor="#91A0B7"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/passengerTabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Main ticket card, with cut-out dividers -->
            <LinearLayout
                android:id="@+id/ticketCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@drawable/bg_rt_qr_ticket">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/cardPassengerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Passenger 1"
                            android:textColor="#182138"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/cardFareType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Regular Fare | Single Journey"
                            android:textColor="#8290A9"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/cardFareBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rt_qr_badge"
                        android:text="Standard"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:clipChildren="false">
                    <View
                        android:id="@+id/dashedDividerTop"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_rt_qr_dash" />
                    <View
                        android:id="@+id/cutoutLeftTop"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="start|center_vertical"
                        android:translationX="-9dp"
                        android:background="@drawable/bg_rt_qr_cutout" />
                    <View
                        android:id="@+id/cutoutRightTop"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical"
                        android:translationX="9dp"
                        android:background="@drawable/bg_rt_qr_cutout" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/qrScannerArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:gravity="center_horizontal"
                    android:paddingTop="17dp"
                    android:paddingBottom="18dp">
                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="215dp">
                        <ImageView
                            android:id="@+id/imgQRCode"
                            android:layout_width="172dp"
                            android:layout_height="172dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:contentDescription="Passenger QR code" />
                        <ImageView
                            android:id="@+id/cornerTopLeft"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="top|start"
                            android:src="@drawable/ic_corner_top_left" />
                        <ImageView
                            android:id="@+id/cornerTopRight"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="top|end"
                            android:src="@drawable/ic_corner_top_right" />
                        <ImageView
                            android:id="@+id/cornerBottomLeft"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|start"
                            android:src="@drawable/ic_corner_bottom_left" />
                        <ImageView
                            android:id="@+id/cornerBottomRight"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|end"
                            android:src="@drawable/ic_corner_bottom_right" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/tvTargetInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:text="◉  Hold ~5 inches from glass scanner target"
                        android:textSize="11sp"
                        android:textColor="#735CCB" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:clipChildren="false">
                    <View
                        android:id="@+id/dashedDividerBottom"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_rt_qr_dash" />
                    <View
                        android:id="@+id/cutoutLeftBottom"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="start|center_vertical"
                        android:translationX="-9dp"
                        android:background="@drawable/bg_rt_qr_cutout" />
                    <View
                        android:id="@+id/cutoutRightBottom"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical"
                        android:translationX="9dp"
                        android:background="@drawable/bg_rt_qr_cutout" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="65dp"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="13dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/lblTrainFare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRAIN FARE:"
                            android:textSize="10sp"
                            android:textColor="#8B98AD"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvTrainFare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#172039"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/lblValidUntil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="VALID UNTIL:"
                            android:textSize="10sp"
                            android:textColor="#8B98AD"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvValidUntil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--"
                            android:textColor="#172039"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextPassenger"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="NEXT PASSENGER QR (2/3)  →"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6B56C8"
            app:cornerRadius="13dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
