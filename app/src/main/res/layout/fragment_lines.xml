<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD">

    <!-- Header, same style as the Tickets tab. The title changes to LRT LINE 1 / 2
         when a line pill is tapped (see LinesActivity.kt). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasans"
            android:letterSpacing="-0.02"
            android:text="LINES"
            android:textColor="#0B1A30"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/linesSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plusjakartasans"
            android:text="Explore LRT-1 and LRT-2 stations"
            android:textColor="#62718A"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Map area -->
    <FrameLayout
        android:id="@+id/mapSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

    <!-- Map. To use your own artwork add: app:baseDrawable / app:lrt1Drawable / app:lrt2Drawable
         (and app:drawLabels="false" if the station names are already inside your layers). -->
    <com.example.railtap.LinesMapView
        android:id="@+id/linesMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:drawLabels="false" />
    </FrameLayout>

    <!-- LRT 1 / LRT 2 pills: indicators + buttons -->
    <LinearLayout
        android:id="@+id/linePills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/pillLrt1"
            style="@style/LinesPill"
            android:background="@drawable/bg_pill_lrt1"
            android:contentDescription="@string/lines_pill_lrt1_desc"
            android:text="@string/lines_pill_lrt1" />

        <TextView
            android:id="@+id/pillLrt2"
            style="@style/LinesPill"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_lrt2"
            android:contentDescription="@string/lines_pill_lrt2_desc"
            android:text="@string/lines_pill_lrt2" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
