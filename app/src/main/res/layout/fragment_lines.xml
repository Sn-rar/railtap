<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD">

    <!-- header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasans"
            android:letterSpacing="-0.02"
            android:text="LINES"
            android:textColor="#0B1A30"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/linesSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plusjakartasans"
            android:text="Explore LRT-1 and LRT-2 stations"
            android:textColor="#62718A"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- map area -->
    <FrameLayout
        android:id="@+id/mapSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- map -->
        <com.example.railtap.LinesMapView
            android:id="@+id/linesMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:drawLabels="false" />
    </FrameLayout>

    <!-- bottom card: pills + travel time -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_top"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="0dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- drag handle -->
        <FrameLayout
            android:id="@+id/panelHandle"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_handle" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/linePills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillLrt1"
                style="@style/LinesPill"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_lrt1"
                android:contentDescription="@string/lines_pill_lrt1_desc"
                android:text="@string/lines_pill_lrt1" />

            <TextView
                android:id="@+id/pillLrt2"
                style="@style/LinesPill"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_lrt2"
                android:contentDescription="@string/lines_pill_lrt2_desc"
                android:text="@string/lines_pill_lrt2" />
        </LinearLayout>

        <include layout="@layout/view_travel_info" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>