<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <include
        android:id="@+id/header"
        layout="@layout/layout_legal_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/legalScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="RailTap — Book, Pay, and Scan to Ride"
                android:textColor="@color/neutral_heading"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                style="@style/LegalBody"
                android:layout_marginTop="16dp"
                android:text="RailTap is a mobile ticketing app for Light Rail Transit (LRT) Lines 1 and 2. Instead of lining up at the ticket booth, you can book your trip on your phone, pay for it with PayPal, and get a QR pass for each passenger that is scanned at the station gate." />

            <TextView
                style="@style/LegalBody"
                android:layout_marginTop="16dp"
                android:text="When booking, you choose your origin and destination stations, add passengers with Student, Senior, or PWD discounts, and see the total fare before paying. The same QR pass is scanned when you enter and again when you exit. Your active passes, completed journeys, receipts, and trip history are kept in your account, and the Lines tab shows the LRT-1 and LRT-2 maps with travel times between stations." />

            <TextView
                style="@style/LegalBody"
                android:layout_marginTop="16dp"
                android:text="Whether you're traveling for school, work, or leisure, RailTap lets you have your ticket ready before you reach the station." />

            <View
                style="@style/LegalDivider"
                android:layout_marginTop="32dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="RailTap — Book it. Scan it. Ride."
                android:textColor="@color/brand"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>