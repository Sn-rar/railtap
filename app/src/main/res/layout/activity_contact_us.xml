<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <include
        android:id="@+id/header"
        layout="@layout/layout_legal_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/legalScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="Contact Us"
                android:textColor="@color/neutral_heading"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/LegalBody"
                android:text="Have questions or need assistance with RailTap? We're here to help! Whether you have concerns about NFC, QR code transactions, payments, or app functionality, feel free to reach out to us." />

            <!-- Info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_contact_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:letterSpacing="0.08"
                    android:text="EMAIL"
                    android:textColor="@color/brand"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plusjakartasans"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="railtap.support@gmail.com"
                    android:textColor="@color/neutral_heading"
                    android:textIsSelectable="false"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#4DC9C4D5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:letterSpacing="0.08"
                    android:text="RESPONSE HOURS"
                    android:textColor="@color/brand"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/plusjakartasans"
                    android:lineSpacingExtra="4dp"
                    android:text="Monday–Friday, 9:00 AM–5:00 PM (Philippine Standard Time)"
                    android:textColor="@color/neutral_heading"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                style="@style/LegalBody"
                android:layout_marginTop="24dp"
                android:text="We aim to respond to all inquiries within 1–3 business days. Thank you for choosing RailTap!" />

            <View style="@style/LegalDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="RailTap — Your Journey, One Tap Away."
                android:textColor="@color/brand"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>