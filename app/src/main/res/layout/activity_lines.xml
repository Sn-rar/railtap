<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <!-- Map. To use your own artwork add: app:baseDrawable / app:lrt1Drawable / app:lrt2Drawable
         (and app:drawLabels="false" if the station names are already inside your layers). -->
    <com.example.railtap.LinesMapView
        android:id="@+id/linesMap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:drawLabels="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LRT 1 / LRT 2 pills: indicators + buttons -->
    <LinearLayout
        android:id="@+id/linePills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/pillLrt1"
            style="@style/LinesPill"
            android:background="@drawable/bg_pill_lrt1"
            android:contentDescription="@string/lines_pill_lrt1_desc"
            android:text="@string/lines_pill_lrt1" />

        <TextView
            android:id="@+id/pillLrt2"
            style="@style/LinesPill"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_lrt2"
            android:contentDescription="@string/lines_pill_lrt2_desc"
            android:text="@string/lines_pill_lrt2" />
    </LinearLayout>

    <!-- Bottom Navigation (same ids as the other screens; Lines is the active tab) -->
    <!-- Shared bottom bar (same as every other tab) -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
