<?xml version="1.0" encoding="utf-8"?>
<!-- Styles for the shared bottom navigation bar (layout_bottom_nav.xml) -->
<resources>
    <!-- One tab: icon on top, label below, equal width -->
    <style name="BottomNavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="BottomNavIcon">
        <item name="android:layout_width">@dimen/bottom_nav_icon_size</item>
        <item name="android:layout_height">@dimen/bottom_nav_icon_size</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/bottom_nav_inactive</item>
    </style>

    <style name="BottomNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/plusjakartasans</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/bottom_nav_inactive</item>
        <item name="android:textSize">@dimen/bottom_nav_text_size</item>
    </style>
</resources>
